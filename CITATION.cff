    title: "BeeSensor: An energy-efficient and scalable routing protocol for wireless sensor networks"
    authors:
      - family-names: "Saleem"
        given-names: "Muhammad"
      - family-names: "Ullah"
        given-names: "Israr"
      - family-names: "Farooq"
        given-names: "Muddassar"
    journal: "Information Sciences"
    volume: "200"
